// Filled in by build.rs (the version from Cargo.toml) and compiled from OUT_DIR.
#include <winver.h>
1 ICON "@ROOT@/icon.ico"
1 24 "@ROOT@/windows/app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @NUMBERS@
PRODUCTVERSION @NUMBERS@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Echo VR Launcher contributors"
      VALUE "FileDescription", "Echo VR Launcher"
      VALUE "FileVersion", "@VERSION@"
      VALUE "InternalName", "EchoVR_Launcher"
      VALUE "LegalCopyright", "GPL-3.0-or-later"
      VALUE "OriginalFilename", "EchoVR_Launcher.exe"
      VALUE "ProductName", "Echo VR Launcher"
      VALUE "ProductVersion", "@VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
