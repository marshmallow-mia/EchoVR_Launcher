{
  "schema": 2,
  "id": "event-lobbies",
  "name": "Event lobbies",
  "version": "0.2.0",
  "author": "heisthecat31",
  "summary": "Play the event builds together: see the public matches on the classic lobbies server, join a friend's match by its id, and request a game server.",
  "icon": "calendar",
  "wasm": "plugin.wasm",
  "permissions": {
    "net": [
      "relay",
      "typed"
    ],
    "relay_password": true,
    "play": true
  },
  "settings": {
    "store": {
      "file": "settings.json",
      "format": "json"
    },
    "sections": [
      {
        "title": "Account",
        "help": "Your account on the classic lobbies server. Empty: the one the launcher uses for event builds.",
        "fields": [
          {
            "key": "server",
            "type": "text",
            "label": "Server",
            "help": "Address and port, e.g. 168.119.2.92:6800"
          },
          {
            "key": "name",
            "type": "text",
            "label": "Display name"
          },
          {
            "key": "password",
            "type": "secret",
            "label": "Password"
          }
        ]
      }
    ]
  }
}
