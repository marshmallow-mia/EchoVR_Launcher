{
  "schema": 2,
  "id": "game-server",
  "name": "Game server",
  "version": "0.3.0",
  "author": "marshmallow-mia",
  "summary": "Play Echo VR on another server than EchoVRCE: a community EchoRelay server (just its address and a name), or a Nakama server. Back to EchoVRCE with one button.",
  "icon": "plugin",
  "wasm": "plugin.wasm",
  "permissions": {
    "net": [
      "relay"
    ],
    "relay_password": true,
    "game_server": true
  },
  "settings": {
    "store": {
      "file": "settings.json",
      "format": "json"
    },
    "sections": [
      {
        "title": "EchoRelay",
        "fields": [
          {
            "key": "relay_address",
            "type": "text",
            "label": "Address",
            "help": "host:port. Empty: the classic lobbies server"
          },
          {
            "key": "relay_name",
            "type": "text",
            "label": "Display name",
            "help": "Empty: your classic lobbies name"
          },
          {
            "key": "relay_password",
            "type": "secret",
            "label": "Password",
            "help": "Empty: your classic lobbies password"
          }
        ]
      },
      {
        "title": "Nakama",
        "fields": [
          {
            "key": "name",
            "type": "text",
            "label": "Name",
            "help": "For you, e.g. EchoCombat test"
          },
          {
            "key": "address",
            "type": "text",
            "label": "Address",
            "help": "host:port (7350 when left out), or a ws:// or wss:// address"
          },
          {
            "key": "key",
            "type": "secret",
            "label": "Server key",
            "help": "Unless the address carries it (token=)"
          },
          {
            "key": "discord_id",
            "type": "text",
            "label": "Discord ID",
            "help": "Your account there"
          },
          {
            "key": "password",
            "type": "secret",
            "label": "Password",
            "help": "Your password there, not your Discord one: it's kept in plain text"
          }
        ]
      }
    ]
  }
}
